#!/usr/bin/env bash
# sigmaos-libreoffice — SigmaOS helper for libreoffice.
set -euo pipefail
APP="libreoffice"
cmd="${1:-status}"
case "$cmd" in
  launch)  xdg-open "$(command -v $APP || command -v ${APP}bin || echo /usr/bin/$APP)" 2>/dev/null || echo "$APP not installed";;
  config)  echo "config dir: $HOME/.config/LIBREOFFICE"; ls "$HOME/.config/LIBREOFFICE" 2>/dev/null | head;;
  reset)   echo "remove $HOME/.config/LIBREOFFICE to reset $APP";;
  *) echo "usage: sigmaos-libreoffice launch|config|reset" >&2; exit 2;;
esac
